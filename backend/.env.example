# ==============================================================================
# LeftoverLoop Backend Environment Variables Template
# Copy this file to .env (or backend/.env) and supply your actual credentials.
# ==============================================================================

# Server Port
PORT=8080

# ------------------------------------------------------------------------------
# OPTION 1: Aiven Cloud MySQL Configuration (Recommended for Cloud Hosting)
# ------------------------------------------------------------------------------
# Replace <aiven-host>, <aiven-port>, <aiven-database>, <aiven-username>, <aiven-password>
# with your actual connection details from the Aiven Console.
# TLS/SSL is required by Aiven (sslMode=REQUIRED, useSSL=true, requireSSL=true).
#
# SPRING_DATASOURCE_URL=jdbc:mysql://<aiven-host>:<aiven-port>/<aiven-database>?sslMode=REQUIRED&useSSL=true&requireSSL=true&verifyServerCertificate=false
# SPRING_DATASOURCE_USERNAME=<aiven-username>
# SPRING_DATASOURCE_PASSWORD=<aiven-password>

# ------------------------------------------------------------------------------
# OPTION 2: Local MySQL Configuration (For Local Development)
# ------------------------------------------------------------------------------
# Use this if you have a local MySQL server installed and running.
# Replace root/your_password with your actual local MySQL username and password.
#
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/leftoverloop_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=your_mysql_username
SPRING_DATASOURCE_PASSWORD=your_mysql_password

# Hibernate Schema Action (update, validate, none)
SPRING_JPA_DDL_AUTO=update

# ------------------------------------------------------------------------------
# JWT Security Configuration
# ------------------------------------------------------------------------------
JWT_SECRET=your_super_secret_jwt_key_here_min_256bit_hex_or_base64
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# AI Recommendation Service (Optional)
# ------------------------------------------------------------------------------
# Set your Google Gemini API Key here to enable live cloud AI recommendations.
# Leave blank to use the built-in LeftoverLoop Smart Match Engine.
AI_API_KEY=
AI_PROVIDER=gemini
AI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent
