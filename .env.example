# ==============================================================================
# LeftoverLoop Platform Environment Variables Template
# Copy this file to .env and configure your database and API credentials.
# ==============================================================================

# Server Settings
PORT=8080

# ------------------------------------------------------------------------------
# OPTION 1: Aiven Cloud MySQL Configuration (Cloud Managed Database)
# ------------------------------------------------------------------------------
# Replace placeholders with your service connection parameters from Aiven Console:
#
# SPRING_DATASOURCE_URL=jdbc:mysql://<aiven-host>:<aiven-port>/<aiven-database>?sslMode=REQUIRED&useSSL=true&requireSSL=true&verifyServerCertificate=false
# SPRING_DATASOURCE_USERNAME=<aiven-username>
# SPRING_DATASOURCE_PASSWORD=<aiven-password>

# ------------------------------------------------------------------------------
# OPTION 2: Local MySQL Configuration (Local Development)
# ------------------------------------------------------------------------------
# Set your local database credentials below:
#
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/leftoverloop_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=your_mysql_username
SPRING_DATASOURCE_PASSWORD=your_mysql_password

# Schema management
SPRING_JPA_DDL_AUTO=update

# Security / JWT Secret Key (Minimum 256-bit strong secret)
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production_min_256bit
JWT_EXPIRATION_MS=86400000

# Genuine AI Recommendation Service (Google Gemini API Key)
# Leave blank to use built-in LeftoverLoop Smart Match Engine
AI_API_KEY=
AI_PROVIDER=gemini
AI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent
